{
  "manifest_version": 3,
  "name": "Maria Browser Sign-in",
  "version": "1.0.0",
  "description": "Connect your existing ChatGPT sign-in to Maria WebGPT on this device.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://auth.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Connect to Maria",
    "default_popup": "connect.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* https://chatgpt.com"
  },
  "key": "",
  "icons": {
    "128": "icon.png"
  }
}
