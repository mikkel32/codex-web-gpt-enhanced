diff --git a/tests/codex-integration-legacy-provider.test.ts b/tests/codex-integration-legacy-provider.test.ts
new file mode 100644
index 0000000..e42dd27
--- /dev/null
+++ b/tests/codex-integration-legacy-provider.test.ts
@@ -0,0 +1,170 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import {
+  activateCodexIntegration,
+  deactivateCodexIntegration,
+  getCodexJournalPath,
+  getCodexJournalRecoveryPath,
+  getCodexModelsCachePath,
+  installCodexIntegration,
+  uninstallCodexIntegration,
+} from "../src/codex-integration";
+import { defaultConfig } from "../src/config";
+import { MANAGED_COMMENT } from "../src/codex-integration-shared";
+
+const roots: string[] = [];
+const routeUrl = "http://127.0.0.1:17841/v1";
+
+function fixture(): { root: string; codexHome: string; configPath: string } {
+  const root = join(
+    process.env.TMPDIR ?? "/tmp",
+    `codex-web-legacy-provider-${process.pid}-${Date.now()}-${Math.random()}`,
+  );
+  const codexHome = join(root, "codex");
+  mkdirSync(codexHome, { recursive: true });
+  roots.push(root);
+  process.env.CODEX_HOME = codexHome;
+  process.env.CODEX_CHATGPT_WEB_HOME = join(root, "app");
+  return { root, codexHome, configPath: join(codexHome, "config.toml") };
+}
+
+function legacyConfig(extraProviderLine?: string): string {
+  return [
+    'model = "gpt-6-astra"',
+    'model_provider = "chatgpt_web_bridge"',
+    "model_context_window = 1000000",
+    "model_auto_compact_token_limit = 900000",
+    "model_reasoning_effort = \"xhigh\"",
+    MANAGED_COMMENT,
+    `openai_base_url = ${JSON.stringify(routeUrl)}`,
+    "[model_providers.chatgpt_web_bridge]",
+    'name = "ChatGPT Web Bridge"',
+    `base_url = ${JSON.stringify(routeUrl)}`,
+    'wire_api = "responses"',
+    "requires_openai_auth = true",
+    "supports_websockets = false",
+    ...(extraProviderLine ? [extraProviderLine] : []),
+    "",
+    "[marketplaces.sample]",
+    'name = "Sample"',
+    "",
+  ].join("\n");
+}
+
+function legacyJournal(configPath: string) {
+  return {
+    version: 8,
+    active: true,
+    configPath,
+    installed: {
+      openai_base_url: routeUrl,
+      subagent_protocol: "native",
+    },
+    previous: {
+      openai_base_url: { present: false },
+      model_provider: {
+        present: true,
+        rawLine: 'model_provider = "chatgpt_web_bridge"',
+        value: "chatgpt_web_bridge",
+        index: 1,
+      },
+      model_catalog_json: { present: false },
+    },
+    format: { lineEnding: "\n", trailingNewline: true },
+  } as const;
+}
+
+function writeLegacyState(configPath: string, configText: string): string {
+  writeFileSync(configPath, configText);
+  const encoded = `${JSON.stringify(legacyJournal(configPath), null, 2)}\n`;
+  mkdirSync(dirname(getCodexJournalPath()), { recursive: true });
+  writeFileSync(getCodexJournalPath(), encoded);
+  writeFileSync(getCodexJournalRecoveryPath(), encoded);
+  writeFileSync(getCodexModelsCachePath(), "stale cache");
+  return encoded;
+}
+
+afterEach(() => {
+  delete process.env.CODEX_HOME;
+  delete process.env.CODEX_CHATGPT_WEB_HOME;
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+describe("legacy global provider migration", () => {
+  test("adopts the clean native route and never restores the bridge provider", () => {
+    const { configPath } = fixture();
+    writeLegacyState(configPath, legacyConfig());
+    const config = defaultConfig("browser-only");
+    config.subagentProtocol = "native";
+
+    const upgraded = installCodexIntegration(config);
+    const installed = readFileSync(configPath, "utf8");
+    expect(upgraded.version).toBe(10);
+    expect(upgraded.previous.model_provider).toEqual({ present: false });
+    expect(installed).toContain('model = "gpt-6-astra"');
+    expect(installed).toContain("model_context_window = 1000000");
+    expect(installed).toContain("[marketplaces.sample]");
+    expect(installed).toContain(`openai_base_url = ${JSON.stringify(routeUrl)}`);
+    expect(installed).not.toContain('model_provider = "chatgpt_web_bridge"');
+    expect(installed).not.toContain("[model_providers.chatgpt_web_bridge]");
+    expect(existsSync(getCodexModelsCachePath())).toBe(false);
+
+    expect(deactivateCodexIntegration()).toEqual({ changed: true, active: false });
+    const nativeOnly = readFileSync(configPath, "utf8");
+    expect(nativeOnly).toContain('model = "gpt-6-astra"');
+    expect(nativeOnly).not.toContain("openai_base_url");
+    expect(nativeOnly).not.toContain("chatgpt_web_bridge");
+
+    expect(activateCodexIntegration()).toEqual({ changed: true, active: true });
+    expect(readFileSync(configPath, "utf8")).not.toContain("chatgpt_web_bridge");
+    expect(uninstallCodexIntegration()).toEqual({ changed: true });
+    const uninstalled = readFileSync(configPath, "utf8");
+    expect(uninstalled).toContain('model = "gpt-6-astra"');
+    expect(uninstalled).not.toContain("openai_base_url");
+    expect(uninstalled).not.toContain("chatgpt_web_bridge");
+  });
+
+  test("adopts a provider assignment that the user already removed manually", () => {
+    const { configPath } = fixture();
+    const manuallyCleaned = legacyConfig()
+      .replace('model_provider = "chatgpt_web_bridge"\n', "")
+      .replace(/\[model_providers\.chatgpt_web_bridge\][\s\S]*?\n\n(?=\[marketplaces\.sample\])/, "");
+    writeLegacyState(configPath, manuallyCleaned);
+    const config = defaultConfig("browser-only");
+    config.subagentProtocol = "native";
+
+    const upgraded = installCodexIntegration(config);
+    expect(upgraded.previous.model_provider).toEqual({ present: false });
+    expect(readFileSync(configPath, "utf8")).not.toContain("chatgpt_web_bridge");
+  });
+
+  test("fails closed when the old provider table was edited", () => {
+    const { configPath } = fixture();
+    const originalConfig = legacyConfig("custom_setting = true");
+    const originalJournal = writeLegacyState(configPath, originalConfig);
+    const config = defaultConfig("browser-only");
+    config.subagentProtocol = "native";
+
+    expect(() => installCodexIntegration(config)).toThrow("provider table was edited");
+    expect(readFileSync(configPath, "utf8")).toBe(originalConfig);
+    expect(readFileSync(getCodexJournalPath(), "utf8")).toBe(originalJournal);
+    expect(readFileSync(getCodexJournalRecoveryPath(), "utf8")).toBe(originalJournal);
+  });
+});
