@@ -0,0 +1,105 @@
+import type { PreviousAssignment } from "./codex-integration-shared";
+import {
+  findTopLevelAssignment,
+  parseDocument,
+  removeDocumentLine,
+  renderDocument,
+} from "./codex-integration-document";
+
+export const LEGACY_CHATGPT_WEB_PROVIDER = "chatgpt_web_bridge";
+const LEGACY_PROVIDER_ASSIGNMENT = `model_provider = ${JSON.stringify(LEGACY_CHATGPT_WEB_PROVIDER)}`;
+const LEGACY_PROVIDER_TABLE = "model_providers.chatgpt_web_bridge";
+
+interface TableRange {
+  headerIndex: number;
+  endIndex: number;
+}
+
+function findTable(lines: string[], tableName: string): TableRange | undefined {
+  const escaped = tableName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const header = new RegExp(`^\\s*\\[${escaped}\\]\\s*(?:#.*)?$`);
+  const matches = lines
+    .map((line, index) => header.test(line) ? index : -1)
+    .filter(index => index >= 0);
+  if (matches.length > 1) throw new Error(`Codex config contains duplicate [${tableName}] tables`);
+  const headerIndex = matches[0];
+  if (headerIndex === undefined) return undefined;
+  const relativeEnd = lines
+    .slice(headerIndex + 1)
+    .findIndex(line => /^\s*\[\[?[^\]]+\]\]?\s*(?:#.*)?$/.test(line));
+  return {
+    headerIndex,
+    endIndex: relativeEnd < 0 ? lines.length : headerIndex + 1 + relativeEnd,
+  };
+}
+
+function exactLegacyProviderTable(
+  lines: string[],
+  installedUrl: string,
+): { state: "absent" | "exact" | "modified"; range?: TableRange } {
+  const range = findTable(lines, LEGACY_PROVIDER_TABLE);
+  if (!range) return { state: "absent" };
+  const expected = new Map<string, string>([
+    ["name", JSON.stringify("ChatGPT Web Bridge")],
+    ["base_url", JSON.stringify(installedUrl)],
+    ["wire_api", JSON.stringify("responses")],
+    ["requires_openai_auth", "true"],
+    ["supports_websockets", "false"],
+  ]);
+  const actual = new Map<string, string>();
+  for (let index = range.headerIndex + 1; index < range.endIndex; index += 1) {
+    const line = lines[index]!;
+    if (!line.trim() || /^\s*#/.test(line)) continue;
+    const match = /^\s*([A-Za-z0-9_-]+)\s*=\s*(.+?)\s*$/.exec(line);
+    if (!match || !expected.has(match[1]!)) return { state: "modified", range };
+    if (actual.has(match[1]!)) return { state: "modified", range };
+    actual.set(match[1]!, match[2]!);
+  }
+  if (actual.size !== expected.size) return { state: "modified", range };
+  for (const [key, value] of expected) {
+    if (actual.get(key) !== value) return { state: "modified", range };
+  }
+  return { state: "exact", range };
+}
+
+/**
+ * Releases the provider override written by pre-v5 launchers. Those builds selected a custom
+ * provider globally, causing every official Codex model to depend on the browser bridge. Ownership
+ * is proven twice: the old journal must contain the exact generated assignment and the active file
+ * must contain the exact generated provider table. Edited or ambiguous state fails closed.
+ */
+export function migrateLegacyChatGptWebProvider(
+  text: string,
+  installedUrl: string,
+  previousModelProvider: PreviousAssignment,
+): { text: string; migrated: boolean } {
+  if (!previousModelProvider.present
+    || previousModelProvider.rawLine !== LEGACY_PROVIDER_ASSIGNMENT
+    || previousModelProvider.value !== LEGACY_CHATGPT_WEB_PROVIDER) {
+    return { text, migrated: false };
+  }
+
+  const document = parseDocument(text);
+  const current = findTopLevelAssignment(document.lines, "model_provider");
+  const table = exactLegacyProviderTable(document.lines, installedUrl);
+  if (!current.present) {
+    if (table.state === "exact" && table.range) {
+      for (let index = table.range.endIndex - 1; index >= table.range.headerIndex; index -= 1) {
+        removeDocumentLine(document, index);
+      }
+    }
+    return { text: renderDocument(document), migrated: true };
+  }
+  if (current.rawLine !== LEGACY_PROVIDER_ASSIGNMENT
+    || current.value !== LEGACY_CHATGPT_WEB_PROVIDER
+    || current.index === undefined) {
+    throw new Error(
+      "The legacy ChatGPT Web model_provider assignment was edited; refusing to overwrite the current Codex provider",
+    );
+  }
+  if (table.state !== "exact" || !table.range) {
+    throw new Error(
+      "The legacy ChatGPT Web provider table was edited; refusing to remove configuration that is no longer provably launcher-owned",
+    );
+  }
+  for (let index = table.range.endIndex - 1; index >= table.range.headerIndex; index -= 1) {
+    removeDocumentLine(document, index);
+  }
+  removeDocumentLine(document, current.index);
+  return { text: renderDocument(document), migrated: true };
+}
